import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class Task1_Calculator extends JFrame {

    private final JTextField field1 = new JTextField(10);
    private final JTextField field2 = new JTextField(10);
    private final JLabel resultLabel = new JLabel("Result: —", JLabel.CENTER);

    public Task1_Calculator() {
        super("Калькулятор — Задание 1");
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLayout(new GridLayout(5, 2, 5, 5));
        setSize(600, 400);
        setLocationRelativeTo(null);

        add(new JLabel("Первое число:"));
        add(field1);
        add(new JLabel("Второе число:"));
        add(field2);

        JPanel buttonsPanel = new JPanel(new GridLayout(1, 4, 3, 3));
        JButton addBtn = new JButton("+");
        JButton subBtn = new JButton("−");
        JButton mulBtn = new JButton("×");
        JButton divBtn = new JButton("÷");
        buttonsPanel.add(addBtn);
        buttonsPanel.add(subBtn);
        buttonsPanel.add(mulBtn);
        buttonsPanel.add(divBtn);

        add(buttonsPanel);
        add(resultLabel);

        addBtn.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                calc('+');
            }
        });

        subBtn.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                calc('-');
            }
        });

        mulBtn.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                calc('*');
            }
        });

        divBtn.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                calc('/');
            }
        });
    }

    private void calc(char op) {
        try {
            double a = Double.parseDouble(field1.getText().trim().replace(',', '.'));
            double b = Double.parseDouble(field2.getText().trim().replace(',', '.'));
            double result;
            switch (op) {
                case '+': result = a + b; break;
                case '-': result = a - b; break;
                case '*': result = a * b; break;
                case '/':
                    if (b == 0) throw new ArithmeticException("Деление на ноль!");
                    result = a / b;
                    break;
                default: return;
            }
            resultLabel.setText("Result: " + result);
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this,
                    "Ошибка: введите корректные числа!",
                    "Ошибка ввода", JOptionPane.ERROR_MESSAGE);
        } catch (ArithmeticException ex) {
            JOptionPane.showMessageDialog(this,
                    ex.getMessage(), "Ошибка", JOptionPane.ERROR_MESSAGE);
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new Task1_Calculator().setVisible(true));
    }
}

import javax.swing.*;
import java.awt.*;
