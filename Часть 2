package src;

public class StopWatch {
    private long startTime;
    private long endTime;

    // Конструктор инициализирует startTime текущим временем
    public StopWatch() {
        this.startTime = System.currentTimeMillis();
    }

    // Сброс startTime до текущего времени
    public void start() {
        this.startTime = System.currentTimeMillis();
    }

    // Присваивает endTime текущее время
    public void stop() {
        this.endTime = System.currentTimeMillis();
    }

    // Возвращает прошедшее время в миллисекундах
    public long getElapsedTime() {
        return endTime - startTime;
    }

    // Геттеры
    public long getStartTime() { return startTime; }
    public long getEndTime() { return endTime; }
}

package src;

import java.util.Random;

public class HomeTask2 {
    public static void main(String[] args) {
        // 1. Создаем массив из 100 000 чисел
        int size = 100_000;
        int[] array = new int[size];
        Random random = new Random();

        for (int i = 0; i < size; i++) {
            array[i] = random.nextInt(100_000); // Случайные числа от 0 до 99999
        }

        // 2. Создаем секундомер и запускаем его
        StopWatch stopWatch = new StopWatch();
        stopWatch.start();

        // 3. Сортировка методом выбора (Selection Sort)
        selectionSort(array);

        // 4. Останавливаем секундомер
        stopWatch.stop();

        // 5. Выводим результат
        System.out.println("Сортировка 100 000 чисел методом выбора заняла: "
                + stopWatch.getElapsedTime() + " мс.");
    }

    // Реализация сортировки методом выбора
    public static void selectionSort(int[] arr) {
        int n = arr.length;

        for (int i = 0; i < n - 1; i++) {
            int minIndex = i;
            for (int j = i + 1; j < n; j++) {
                if (arr[j] < arr[minIndex]) {
                    minIndex = j;
                }
            }
            // Меняем местами
            int temp = arr[minIndex];
            arr[minIndex] = arr[i];
            arr[i] = temp;
        }
    }
}
